{
    "applications": {
        "default": {
            "name": "Project",
            "version": "1.0.1",
            "description": "A Testing Deployment From A Custom Cython Development Environment",
            "company": "Company",
            "url": "https://google.com",
            "icon_path": "assets/icon.ico",
            "license_path": "LICENSE.txt",
            "selected_environment": "development",
            "selected_key": "SelectedEnvironment",
            "root_sub_key": "Software",
            "sub_data_key": "Data"
        },
        "development": {
            "selected_environment": "development"
        },
        "testing": {
            "selected_environment": "testing"
        },
        "release": {
            "selected_environment": "release"
        }
    },
    "testing": {
        "input_path": "tests",
        "benchmarking_output_path": "tests",
        "is_benchmarking_saved": 1
    },
    "build": {
        "output_path": "build",
        "binding_setup_path": "bindings/setup.pyx",
        "binding_input_paths": ["c", "cpp"],
        "binding_miscellaneous_input_paths": ["setup"],
        "input_paths": ["bindings", "sources"],
        "included_imports": [],
        "extra_compile_args_set_1": [
            "/O2",             
            "/GL",             
            "/arch:AVX2",      
            "/fp:fast",        
            "/favor:fast",     
            "/openmp",         
            "/Oi",             
            "/Gy"             
        ],
        "extra_link_args_1": [
            "/LTCG"  
        ],
        "default_environment": "development",
        "environment_selections": ["development", "testing", "release"],
        "configuration_output_folder_path": "configurations",
        "configuration_output_file_path": "application.json",
        "configuration_sections": ["application", "environment"]
    },
    "compilation": {
        "tool": "nuitka",
        "entry_path": "app",
        "output_path": ".releases",
        "input_paths": ["assets", "configurations"],
        "input_file_paths": ["LICENSE.txt"],
        "include_packages": ["sources", "bindings"],
        "source_path": "sources",
        "request_for_windows_uac_admin_permissions": 0,
        "compilation_report_path": ".logs/compilation-report.xml",
        "excluded_imports": ["setuptools", "pkg_resources", "libcrypto"],
        "platform": "console"
    },
    "compression": {
        "type": "tar.xz",
        "level": 9
    },
    "release": {
        "installment_template_path": ".cylon/configurations/inno_setup.iss",
        "windows_architecture": "x64"
    },
    "cylon": {
        "path": ".cylon"
    },
    "logs": {
        "is_enabled": {
            "all": 1,
            "console": 1,
            "file": 0
        },
        "timestamp_format": "yyyy-MM-dd HH:mm:ss",
        "log_path": ".logs/cylon.log"
    },
    "scripts": {
        "setup_cython_build": ".cylon/utilities/setup_cython_build.py",
        "setup_cython_bindings": ".cylon/setup_cython_bindings.ps1",
        "setup_cython_bindings_utility": ".cylon/utilities/setup_cython_bindings.py",
        "build": ".cylon/build.ps1",
        "test": ".cylon/test.ps1",
        "compile": ".cylon/compile.ps1",
        "post_compile": ".cylon/post_compile.ps1",
        "release": ".cylon/release.ps1",
        "compress": ".cylon/compress.ps1",
        "show_package_sizes": ".cylon/show_package_sizes.ps1",
        "show_package_sizes_utilities": ".cylon/utilities/show_package_sizes.py",
        "show_secrets": ".cylon/show_secrets.ps1",
        "show_secrets_utilities": ".cylon/utilities/show_secrets.py",
        "show_selected_environment": ".cylon/show_selected_environment.ps1",
        "show_selected_environment_utilities": ".cylon/utilities/show_selected_environment.py",
        "setup_secrets": ".cylon/setup_secrets.ps1",
        "setup_secrets_utilities": ".cylon/utilities/setup_secrets.py",
        "setup_configurations": ".cylon/setup_configurations.ps1",
        "setup_configurations_utilities": ".cylon/utilities/setup_configurations.py",
        "setup_tar_compression": ".cylon/setup_tar_compression.ps1",
        "setup_tar_compression_utilities": ".cylon/utilities/setup_tar_compression.py",
        "setup_selected_environment": ".cylon/setup_selected_environment.ps1",
        "setup_selected_environment_utilities": ".cylon/utilities/setup_selected_environment.py",
        "setup_installment": ".cylon/setup_installment.ps1",
        "logger_utilities": ".cylon/utilities/logger.ps1",
        "import_utilities": ".cylon/utilities/imports.ps1",
        "iscc": "C:/Program Files (x86)/Inno Setup 6/ISCC.exe"
    }  
}
